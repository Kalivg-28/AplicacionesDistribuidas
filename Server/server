async function findAllData(client) {
  const results = await client
    .db("sample_mflix")
    .collection("movies")
    .find({})
    .limit(2)
    .toArray();

  if (results.length > 0) console.log("Title:", results[0].title);

  console.log("Películas encontradas:");
  console.log(JSON.stringify(results, null, 2));
}

